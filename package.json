{
  "name": "gigradar",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Upwork client intent scores, hire-rate red flags, name extraction and proposal hooks.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/capture-store-shots.js",
    "zip": "vite build && powershell -NoProfile -Command \"Compress-Archive -Path dist/* -DestinationPath gigradar.zip -Force\""
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.268",
    "@types/node": "^26.2.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
