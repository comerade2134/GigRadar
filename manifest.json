{
  "manifest_version": 3,
  "name": "GigRadar — Upwork Client Inspector",
  "version": "0.2.0",
  "description": "Instant client intent scores, hire-rate red flags, client name extraction and proposal hooks for Upwork freelancers.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "alarms", "notifications"],
  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://www.upwork.com/*"
  ],
  "action": {
    "default_title": "GigRadar",
    "default_popup": "src/popup/index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.upwork.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.upwork.com/nx/proposals/job/*",
        "https://www.upwork.com/ab/proposals/job/*"
      ],
      "js": ["src/content/proposal-autofill.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["src/content/payment-relay.ts"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
